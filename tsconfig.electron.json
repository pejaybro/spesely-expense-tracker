{
  "compilerOptions": {
    "outDir": "./electron",
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["electron/main.ts", "electron/preload.ts"],
  "exclude": ["node_modules"]
}
